# Django Security & Debug Settings
DJANGO_SECRET_KEY=votre_cle_secrete_django_production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,votre-domaine.ci,localhost,127.0.0.1

# Database - Supabase (PostgreSQL)
# Format Supabase: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.xxxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Alternative: Standard MySQL Configuration (if not using Supabase)
# DB_NAME=habitat_construction
# DB_USER=habitat_user
# DB_PASSWORD=votre_mot_de_passe
# DB_HOST=localhost
# DB_PORT=3306
